{
  "name": "skill-side-effect-ledger",
  "version": "0.1.0",
  "description": "Extract side-effect ledgers from agent run logs for approval review.",
  "type": "module",
  "bin": {
    "skill-side-effect-ledger": "./bin/skill-side-effect-ledger.js"
  },
  "scripts": {
    "test": "node --test",
    "check": "node --check bin/skill-side-effect-ledger.js && node --check src/index.js && node --check src/report.js && node --check scripts/package-smoke.js",
    "smoke": "node bin/skill-side-effect-ledger.js --input fixtures/run.md --format markdown --fail-on none",
    "package-smoke": "node scripts/package-smoke.js"
  },
  "keywords": [
    "agent-skill",
    "approval",
    "audit",
    "side-effects",
    "cli"
  ],
  "author": "Roger Chappel",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "bin",
    "src",
    "scripts",
    "fixtures",
    "docs",
    "SKILL.md",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rogerchappel/skill-side-effect-ledger.git"
  },
  "bugs": {
    "url": "https://github.com/rogerchappel/skill-side-effect-ledger/issues"
  },
  "homepage": "https://github.com/rogerchappel/skill-side-effect-ledger#readme"
}
